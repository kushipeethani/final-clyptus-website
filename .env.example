# Optional environment configuration for Clyptus website
# Copy this file to .env for local overrides

# Session secret used for signing authentication HMAC cookies (32+ characters)
# SESSION_SECRET=your_random_32_character_session_secret_here

# Rotated Administrative Credentials (generated via `node scripts/generate-password-hash.js "password"`)
# AUTH_CLYPTUS_SALT=
# AUTH_CLYPTUS_HASH=
# AUTH_AUDIT_SALT=
# AUTH_AUDIT_HASH=

# Optional contact form email delivery (Resend)
# Create a Resend API key and set it in your local .env and deployment environment.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=your-inbox@example.com
# CONTACT_FROM_EMAIL=Clyptus Website <onboarding@resend.dev>

# Production Domain
# VITE_DOMAIN=https://clyptus.com

# Groq AI API Key for Keva Chatbot (Llama 3.3 70B)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
