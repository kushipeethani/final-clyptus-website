# Optional environment configuration for Clyptus website
# Copy this file to .env for local overrides

# Session secret used for signing authentication HMAC cookies (32+ characters)
# SESSION_SECRET=your_random_32_character_session_secret_here

# Rotated Administrative Credentials (generated via `node scripts/generate-password-hash.js "password"`)
# AUTH_CLYPTUS_SALT=
# AUTH_CLYPTUS_HASH=
# AUTH_AUDIT_SALT=
# AUTH_AUDIT_HASH=

# Optional Email Notification Provider (Resend or SMTP)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_RECEIVER_EMAIL=contact@clyptus.com

# SMTP Configuration (if using custom SMTP instead of Resend)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Production Domain
# VITE_DOMAIN=https://clyptus.com
